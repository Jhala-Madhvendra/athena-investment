# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (use a dedicated, least-privilege DB user in production)
MONGO_URI=mongodb://localhost:27017/athena

# Comma-separated list of allowed frontend origins for CORS (production)
# Example: FRONTEND_ORIGIN=https://athena.example.com,https://www.athena.example.com
FRONTEND_ORIGIN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Timeout (ms) for outbound requests to external APIs (Yahoo Finance, Twelve Data)
EXTERNAL_API_TIMEOUT_MS=10000

# Data provider selection - "yahoo" (default, unofficial/scraped) or "twelvedata"
# (official API, US equities only on the free tier). Set all three to "twelvedata"
# together; mixing providers across these isn't a supported combination.
FINANCIAL_DATA_PROVIDER=yahoo
FINANCIAL_STATEMENTS_PROVIDER=yahoo
MARKET_DATA_PROVIDER=yahoo

# Required when any of the above are set to "twelvedata". Get a free key at
# twelvedata.com (free tier: 8 requests/minute, 800/day, US equities only).
TWELVE_DATA_API_KEY=
