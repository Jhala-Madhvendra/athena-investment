# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (use a dedicated, least-privilege DB user in production)
MONGO_URI=mongodb://localhost:27017/athena

# Comma-separated list of allowed frontend origins for CORS (production)
# Example: FRONTEND_ORIGIN=https://athena.example.com,https://www.athena.example.com
FRONTEND_ORIGIN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Timeout (ms) for outbound requests to external APIs (Yahoo Finance, Twelve Data)
EXTERNAL_API_TIMEOUT_MS=10000

# Data provider selection - "yahoo" (default, unofficial/scraped) or "twelvedata"
# (official API, US equities only on the free tier). Set all three to "twelvedata"
# together; mixing providers across these isn't a supported combination.
FINANCIAL_DATA_PROVIDER=yahoo
FINANCIAL_STATEMENTS_PROVIDER=yahoo
MARKET_DATA_PROVIDER=yahoo

# Required when any of the above are set to "twelvedata". Get a free key at
# twelvedata.com (free tier: 8 requests/minute, 800/day, US equities only).
TWELVE_DATA_API_KEY=

# AI Equity Research Analyst (Sprint 8) - LLM provider selection.
# "anthropic" (default), "openai", or "gemini" - set only ONE provider's API
# key below to match. Adding a further provider is a self-contained addition
# to backend/ai/providers/, not a change to this switch's callers.
AI_LLM_PROVIDER=anthropic

# Required when AI_LLM_PROVIDER=anthropic. Get a key at console.anthropic.com
# (note: separate billing from a claude.ai Pro/Max subscription - the API
# has its own credit balance). Never sent to the frontend or logged.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Required when AI_LLM_PROVIDER=openai. Get a key at platform.openai.com.
# Never sent to the frontend or logged.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required when AI_LLM_PROVIDER=gemini. Get a key at aistudio.google.com -
# historically the most generous genuine free tier of the three. Never sent
# to the frontend or logged.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Timeout (ms) for the LLM call - kept below server.js's requestTimeout
# (95000ms) so a slow LLM response surfaces Athena's own timeout error
# instead of Express silently killing the connection first. 90s to give
# "thinking" models (e.g. Gemini's newer flash variants) enough room -
# they can spend several thousand tokens on hidden reasoning before any
# visible output, which a short timeout cuts off mid-generation.
AI_REQUEST_TIMEOUT_MS=90000

# Bump this when the AI context or report JSON schema changes shape, so any
# previously persisted reports are treated as stale and regenerated once
# rather than served in an incompatible shape. v2 (Sprint 10) added the
# recentEvents context section and the optional recentDevelopments report field.
AI_PROMPT_VERSION=v2

# News & Event Intelligence (Sprint 10) - news provider selection.
# "yahoo" (default, unofficial/scraped, no key needed - same reliability
# tier as FINANCIAL_DATA_PROVIDER=yahoo), "marketaux" (dedicated news API,
# richer data including article descriptions), or "mock" (development-only
# fixture data - never real news, forced in NODE_ENV=test).
NEWS_PROVIDER=yahoo

# Required when NEWS_PROVIDER=marketaux. Get a free key at marketaux.com -
# check their current free-tier request limits when you sign up. Never sent
# to the frontend or logged.
MARKETAUX_API_KEY=

# How long (ms) stored news for a ticker is considered fresh before GET
# /api/news/:ticker triggers one live provider refresh. News is time-
# sensitive but Athena must not call the provider on every page view -
# see research/engineering/NewsCaching.md.
NEWS_CACHE_TTL_MS=14400000

# How many days a stored news article is kept before Mongo's TTL index
# expires it. Not an archive - see research/engineering/NewsCaching.md.
NEWS_RETENTION_DAYS=90
